# Copie ce fichier en .env et remplis les valeurs.

# Base de données Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/noteo_ai?schema=public"

# Auth (génère une valeur aléatoire, ex: openssl rand -base64 32)
AUTH_SECRET=""

# URL publique de l'app (nécessaire pour l'OAuth Google en production)
APP_BASE_URL="http://localhost:3000"

# Anthropic — clé API Claude (console.anthropic.com). FACULTATIVE : sans elle, l'app tourne
# entièrement en mode démo (MockAIProvider, données fictives, aucun coût). L'ajouter bascule
# automatiquement sur Claude (AnthropicAIProvider) sans rien changer d'autre.
ANTHROPIC_API_KEY=""
# Force le mode démo même si une clé Anthropic est présente : AI_PROVIDER="mock"
AI_PROVIDER=""

# Google OAuth (Gmail, Calendar, Drive) — Google Cloud Console > APIs & Services > Identifiants
# Type: ID client OAuth "Application Web"
# URI de redirection autorisée: {APP_BASE_URL}/api/connect/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shopify — App personnalisée (Admin > Paramètres > Apps et canaux de vente > Développer des apps)
# Scopes nécessaires: read_orders, read_products, read_customers
SHOPIFY_SHOP_DOMAIN=""
SHOPIFY_ADMIN_ACCESS_TOKEN=""

# ElevenLabs (synthèse vocale) — optionnel, fallback automatique sur la voix du navigateur si absent
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# n8n — secret partagé pour sécuriser les webhooks entrants/sortants entre l'app et n8n
N8N_WEBHOOK_SECRET=""

# Compte propriétaire initial (utilisé uniquement par `npm run db:seed`)
OWNER_EMAIL=""
OWNER_PASSWORD=""
